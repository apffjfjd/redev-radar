# 저장소. 기본값은 프로젝트 내 SQLite 파일이다.
REDEV_DATABASE_URL=sqlite:///var/redev_radar.db

# 공공데이터포털 인증키 (국토교통부 실거래가 API). 코드·저장소에 포함하지 않는다.
REDEV_DATA_GO_KR_KEY=

# 지도 배경 타일 (BD-0004 미결정 사항 — 기본값은 OpenStreetMap)
REDEV_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
REDEV_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
